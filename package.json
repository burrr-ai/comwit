{
  "name": "comwit-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.3.0",
  "description": "State and UI libraries behind comwit.io templates.",
  "homepage": "https://library.comwit.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burrr-ai/comwit.git"
  },
  "bugs": {
    "url": "https://github.com/burrr-ai/comwit/issues"
  },
  "license": "MIT",
  "author": "meursyphus",
  "keywords": [
    "react",
    "state-management",
    "vibe-coding",
    "claude-code",
    "llm"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm dev:docs",
    "dev:docs": "pnpm --filter docs dev",
    "docs": "pnpm dev:docs",
    "dev:state": "pnpm --filter @comwit/state dev",
    "dev:ui": "pnpm --filter @comwit/ui dev",
    "dev:playground": "pnpm --filter state-playground dev --port 3001",
    "dev:ui-catalog": "pnpm --filter ui-dev dev",
    "storybook": "pnpm --filter storybook dev",
    "stories": "pnpm --filter storybook stories",
    "registry": "pnpm --filter comwit-ui build:registry",
    "build:packages": "pnpm --filter @comwit/state build && pnpm --filter @comwit/ui build && pnpm registry",
    "build": "pnpm --filter docs build",
    "test": "pnpm --filter @comwit/state test && node --test scripts/workspace.test.mjs",
    "typecheck": "pnpm build:packages && pnpm --filter docs gen && pnpm stories && pnpm -r --if-present typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "format:staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,json,yaml,yml,md,mdx,css,scss,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
