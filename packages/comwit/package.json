{
  "name": "comwit",
  "version": "1.1.1",
  "private": false,
  "homepage": "https://library.comwit.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meursyphus/comwit.git"
  },
  "bugs": {
    "url": "https://github.com/meursyphus/comwit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "React state management for vibe coding. Less tokens. Built for Claude Code.",
  "keywords": [
    "react",
    "state-management",
    "vibe-coding",
    "claude-code",
    "llm",
    "next.js",
    "zustand",
    "tanstack-query",
    "oop",
    "proxy"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "meursyphus",
  "main": "dist/comwit.cjs",
  "module": "dist/comwit.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/comwit.js",
      "require": "./dist/comwit.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "yarn build && yarn test"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "happy-dom": "^20.6.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "es-toolkit": "^1.44.0"
  }
}
