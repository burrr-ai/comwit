  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "es-toolkit": "^1.44.0",
    "immer": "^11.1.4",
    "overlay-kit": "^1.8.6",
    "sonner": "^2.0.7",
    "valtio": "^2.3.0"
  }
}
