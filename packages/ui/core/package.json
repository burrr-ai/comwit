{
  "name": "@comwit/ui",
  "version": "0.0.2",
  "description": "Comwit UI \u2014 headless UI primitives with a self-built behavior/a11y engine (ported from Radix Primitives). The behavior/a11y engine under @comwit/ui-templates.",
  "keywords": [
    "react",
    "headless",
    "ui",
    "primitives",
    "comwit"
  ],
  "homepage": "https://library.comwit.io/ui",
  "license": "MIT",
  "author": "burrr-ai",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "vite build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.8",
    "@react-aria/label": "^3.8.1",
    "@tiptap/extension-image": "^3.22.4",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "aria-hidden": "^1.2.6",
    "react-aria": "^3.50.0",
    "react-remove-scroll": "^2.7.1",
    "react-stately": "^3.48.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.17",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burrr-ai/comwit.git",
    "directory": "packages/ui/core"
  },
  "bugs": {
    "url": "https://github.com/burrr-ai/comwit/issues"
  }
}
