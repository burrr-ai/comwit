{
  "name": "@comwit/ui",
  "version": "0.6.0",
  "description": "Comwit UI — headless UI primitives with a self-built behavior/a11y engine (ported from Radix Primitives), plus the original Comwit icon set under @comwit/ui/icons. Styled, editable component source lives in @comwit/ui-templates.",
  "keywords": [
    "react",
    "headless",
    "ui",
    "primitives",
    "comwit",
    "icons"
  ],
  "homepage": "https://library.comwit.io/ui",
  "license": "MIT",
  "author": "burrr-ai",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js",
      "require": "./dist/icons/index.cjs"
    },
    "./icons/animated": {
      "types": "./dist/icons/animated.d.ts",
      "import": "./dist/icons/animated.js",
      "require": "./dist/icons/animated.cjs"
    },
    "./icons/catalog": {
      "types": "./dist/icons/catalog.d.ts",
      "import": "./dist/icons/catalog.js",
      "require": "./dist/icons/catalog.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node scripts/generate-icons.mjs",
    "dev": "pnpm generate && vite build --watch",
    "build": "pnpm generate && vite build",
    "typecheck": "pnpm generate && tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run && node scripts/verify-icons.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.8",
    "@react-aria/label": "^3.8.1",
    "@tiptap/extension-image": "^3.22.4",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "aria-hidden": "^1.2.6",
    "react-aria": "^3.50.0",
    "react-remove-scroll": "^2.7.1",
    "react-stately": "^3.48.0",
    "react-virtuoso": "^4.18.15"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.17",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "esbuild": "^0.25.12",
    "happy-dom": "^20.6.2",
    "prettier": "^3.5.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burrr-ai/comwit.git",
    "directory": "packages/ui/core"
  },
  "bugs": {
    "url": "https://github.com/burrr-ai/comwit/issues"
  }
}
