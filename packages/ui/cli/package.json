{
  "name": "comwit-ui",
  "version": "0.7.0",
  "description": "Comwit UI CLI — install editable component source with a bundled registry and the @comwit/ui behavior engine. Independent of shadcn tooling.",
  "keywords": [
    "comwit",
    "ui",
    "cli",
    "registry",
    "copy-paste"
  ],
  "homepage": "https://library.comwit.io/ui",
  "license": "MIT",
  "author": "burrr-ai",
  "type": "module",
  "bin": {
    "comwit-ui": "./src/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "registry",
    "README.md"
  ],
  "scripts": {
    "build:registry": "node scripts/build-registry.mjs",
    "prepack": "node scripts/build-registry.mjs",
    "typecheck": "node --check src/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burrr-ai/comwit.git",
    "directory": "packages/ui/cli"
  },
  "bugs": {
    "url": "https://github.com/burrr-ai/comwit/issues"
  }
}
