{
  "name": "@comwit/ui-templates",
  "version": "0.5.0",
  "description": "Comwit UI templates — copy-paste styled components (shadcn-inspired ownership model, no shadcn tooling) built on the @comwit/ui headless engine.",
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwind",
    "cva",
    "comwit",
    "headless"
  ],
  "homepage": "https://library.comwit.io/ui",
  "license": "MIT",
  "author": "burrr-ai",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/globals.css",
    "./styles/globals.css": "./src/styles/globals.css",
    "./lib/utils": "./src/lib/utils.ts",
    "./lib/popup": "./src/lib/popup.tsx",
    "./lib/interaction": "./src/lib/interaction.ts",
    "./*": "./src/components/ui/*.tsx"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@comwit/ui": "workspace:*",
    "@ssgoi/react": "^7.2.0",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "^3.22.4",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "overlay-kit": "^1.9.0",
    "react-day-picker": "^9.14.0",
    "react-hook-form": "^7.63.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.170.39",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "next": "16.2.7",
    "react-router": "^8.4.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burrr-ai/comwit.git",
    "directory": "packages/ui/templates"
  },
  "bugs": {
    "url": "https://github.com/burrr-ai/comwit/issues"
  }
}
