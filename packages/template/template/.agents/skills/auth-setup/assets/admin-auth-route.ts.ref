// ============================================================
// 레퍼런스: admin Better Auth 라우트 핸들러
// 위치: src/app/(admin)/admin/api/auth/[...all]/route.ts
// ============================================================
// 브라우저에는 프로젝트 전용 관리자 경로만 노출한다. Next.js rewrite가
// 내부 /admin 라우트로 연결한 뒤에도 Better Auth가 자신의 basePath를
// 올바르게 매칭하도록 요청 URL만 내부 auth 경로로 정규화한다.
// ============================================================

import {
  ADMIN_AUTH_BASE_PATH,
  INTERNAL_ADMIN_AUTH_BASE_PATH,
} from "@/lib/admin-routes"
import { getAdminAuth } from "@/server/auth/admin"
import { toNextJsHandler } from "better-auth/next-js"

function toInternalAdminAuthRequest(request: Request) {
  const url = new URL(request.url)
  const pathname = decodeURIComponent(url.pathname)

  if (
    pathname === ADMIN_AUTH_BASE_PATH ||
    pathname.startsWith(`${ADMIN_AUTH_BASE_PATH}/`)
  ) {
    url.pathname = `${INTERNAL_ADMIN_AUTH_BASE_PATH}${pathname.slice(ADMIN_AUTH_BASE_PATH.length)}`
    return new Request(url, request)
  }

  return request
}

const handler = async (request: Request) => {
  const auth = await getAdminAuth()
  const nextHandler = toNextJsHandler(auth.handler)
  const internalRequest = toInternalAdminAuthRequest(request)

  if (request.method === "GET") {
    return nextHandler.GET(internalRequest)
  }

  if (request.method === "POST") {
    return nextHandler.POST(internalRequest)
  }

  return new Response("Method not allowed", { status: 405 })
}

export { handler as GET, handler as POST }
