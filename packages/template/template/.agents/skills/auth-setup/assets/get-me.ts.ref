// ============================================================
// Reference: services/{service}/api/user/actions/get-me.ts
// Use this when replacing mock authentication with real authentication.
// ============================================================
// Placeholders:
//   {service} → app, admin, etc.
//   {Service} → App, Admin, etc. (PascalCase)
//   Adjust the User type import path for the service.
// ============================================================

'use server'

import { createAction } from '@/lib/utils'
import { get{Service}ServerSession } from '@/server/auth/{service}'
import type { User } from '@/services/{service}/state/user'

// api.ai.md: every export in actions must be wrapped with createAction (ESLint api-create-action).
// Declare the inner function with a `_` prefix and bundle it via resolveActions({ getMe }) in index.ts.
async function _getMe(): Promise<User | null> {
  // Preserve Better Auth's cookie cache and its session recheck on cache miss/expiry.
  // Admin retains DB-authoritative reads. No extra member/profile queries here.
  const session = await get{Service}ServerSession()
  if (!session?.user) return null

  // convert the auth user into the User type
  return {
    id: session.user.id,
    email: session.user.email,
    name: session.user.name ?? '',
    image: session.user.image ?? null,
    emailVerified: session.user.emailVerified,
    createdAt: session.user.createdAt,
    updatedAt: session.user.updatedAt,
  }
}

export const getMe = createAction(_getMe)

// Map the basic profile only from Better Auth's session.user.
// Load separate member/profile tables lazily through separate APIs/queries.
// A missing member row must not turn an authenticated user into null.
// Propagate session-read failures; never hide them with catch(() => null).
