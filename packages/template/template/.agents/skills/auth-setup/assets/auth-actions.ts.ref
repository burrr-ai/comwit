// ============================================================
// Reference: services/{service}/state/user/actions/auth.ts
// Use this when replacing mock authentication with real authentication.
// ============================================================
// Placeholders:
//   {service} → app, admin, etc.
//   {homePath} → destination expression after sign-in (app: "/", admin: adminRoutes.dashboard)
//   {loginPath} → destination expression after sign-out (app: "/login", admin: adminRoutes.login)
//   auth client import: '@/lib/auth-client/{service}'
//   The useUser hook name depends on the service (useUser, useAdminUser, etc.).
//   For admin, also import adminRoutes from '@/lib/admin-routes'.
// ============================================================

import { action } from "@comwit/state"
import type { UserActions } from "../types"
import { user } from "../model"
import { {service}Auth } from "@/lib/auth-client/{service}"

type UserAuthActions = Pick<
  UserActions,
  "signIn" | "signUp" | "signOut"
>

export const userAuthActions = action<UserAuthActions>(({ state }) => {
  class UserAuthActions {
    private model = state(user)

    async signIn({
      email,
      password,
    }: {
      email: string
      password: string
    }): Promise<void> {
      this.model.isLoading = true

      try {
        const { error } = await {service}Auth.signIn.email({
          email,
          password,
        })

        if (error) {
          throw new Error(error.message)
        }

        // The session cookie is set; navigate to the service home to reload the user on the server.
        window.location.href = {homePath}
      } finally {
        this.model.isLoading = false
      }
    }

    async signUp({
      email,
      name,
      password,
    }: {
      email: string
      name: string
      password: string
    }): Promise<void> {
      this.model.isLoading = true

      try {
        const { error } = await {service}Auth.signUp.email({
          email,
          name,
          password,
        })

        if (error) {
          throw new Error(error.message)
        }

        window.location.href = {homePath}
      } finally {
        this.model.isLoading = false
      }
    }

    async signOut(): Promise<void> {
      this.model.isLoading = true

      try {
        await {service}Auth.signOut()
        this.model.me.set(null)
        window.location.href = {loginPath}
      } finally {
        this.model.isLoading = false
      }
    }
  }

  return new UserAuthActions()
})
