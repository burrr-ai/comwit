{
  "name": "docs",
  "version": "1.0.0",
  "private": true,
  "description": "Documentation site for comwit",
  "homepage": "https://library.comwit.io",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "predev": "pnpm --filter @comwit/state build && pnpm --filter @comwit/ui build && pnpm gen",
    "prebuild": "pnpm --filter @comwit/state build && pnpm --filter @comwit/ui build && pnpm gen",
    "gen": "pnpm --filter comwit-ui build:registry && node scripts/gen-ui.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@comwit/state": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/typography": "^0.5.19",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "motion": "^12.34.0",
    "next": "16.2.7",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "@comwit/ui": "workspace:*",
    "@comwit/ui-templates": "workspace:*",
    "lucide-react": "^0.544.0",
    "overlay-kit": "^1.9.0",
    "react-hook-form": "^7.63.0",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x"
  }
}
